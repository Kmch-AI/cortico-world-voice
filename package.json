{
  "name": "@kmchai/cortico-world-voice",
  "version": "0.5.0",
  "type": "module",
  "description": "Kmch AI · 语音：把文字念出来的 World。只提供 voice_speak / voice_hush、情绪与副语言标签、文本过滤与本机播放；是否发语音由 bot 决定，合成交给 Kmch AI · 服务。",
  "author": "kmchai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kmch-AI/cortico-world-voice.git"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "tts",
    "voice",
    "speech",
    "emotion",
    "语音",
    "语音合成",
    "文本转语音",
    "朗读",
    "情感",
    "音色"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Kmch AI · 语音",
    "locales": {
      "zh": {
        "displayName": "Kmch AI · 语音",
        "description": "Kmch AI · 语音：把文字念出来的 World。只提供 voice_speak / voice_hush、情绪与副语言标签、文本过滤与本机播放；是否发语音由 bot 决定，合成交给 Kmch AI · 服务。"
      },
      "en": {
        "displayName": "Kmch AI · Voice",
        "description": "Kmch AI · Voice: the World that turns text into sound. It only offers voice_speak / voice_hush, emotion and paralinguistic tags, text filtering and local playback; the bot decides when to speak, and synthesis runs through Kmch AI · Service."
      }
    },
    "tags": [
      "voice",
      "external-setup",
      "requires-extension",
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist/webui.js",
    "dist/webui.css",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json",
    "build:webui": "node scripts/build-webui.mjs",
    "smoke:player": "tsx scripts/smoke-player.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
