{
  "name": "@kmchai/cortico-world-voice",
  "version": "0.3.2",
  "type": "module",
  "description": "Cortico World: voice tools, probabilistic reading, emotion and paralinguistic tags, text filtering and local playback; speech is synthesized by the Kmch AI service over HTTP",
  "author": "kmchai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kmch-AI/cortico-world-voice.git"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "tts",
    "voice",
    "speech",
    "emotion",
    "语音",
    "语音合成",
    "文本转语音",
    "朗读",
    "情感",
    "音色"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Kmch AI · 语音",
    "locales": {
      "zh": {
        "displayName": "Kmch AI · 语音",
        "description": "语音 World:工具、概率朗读、情绪与副语言标签、文本过滤、本机播放;协议与 HTTP 服务由 Kmch AI · 服务提供。"
      },
      "en": {
        "displayName": "Kmch AI · Voice",
        "description": "Voice World: tools, probabilistic reading, emotion and paralinguistic tags, text filtering and local playback; the Kmch AI service provides the protocol and HTTP API."
      }
    },
    "tags": [
      "voice",
      "local",
      "external-setup",
      "requires-extension",
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist/webui.js",
    "dist/webui.css",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json",
    "build:webui": "node scripts/build-webui.mjs",
    "smoke:player": "tsx scripts/smoke-player.ts",
    "smoke:chain": "tsx scripts/smoke-chain.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
