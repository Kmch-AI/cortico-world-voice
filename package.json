{
  "name": "@kmchai/cortico-world-voice",
  "version": "0.1.1",
  "type": "module",
  "description": "Cortico World: protocol-agnostic TTS with probabilistic voice replies, emotion and paralinguistic tag control, text filtering, local playback and a local speech API",
  "author": "kmchai",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "tts",
    "voice",
    "speech",
    "emotion",
    "语音",
    "语音合成",
    "文本转语音",
    "朗读",
    "情感",
    "音色"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Voice",
    "locales": {
      "zh": {
        "displayName": "语音",
        "description": "多协议语音 World:按概率自动朗读、控制情绪与副语言标签、过滤要读的文本;本机播放、本地语音接口与唱歌联动。"
      },
      "en": {
        "displayName": "Voice",
        "description": "Protocol-agnostic TTS World: probabilistic voice replies, emotion and paralinguistic tags, speech text filtering, local playback and a local speech API."
      }
    },
    "tags": [
      "voice",
      "local",
      "external-setup",
      "experimental"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:audiocpp": "tsx scripts/smoke-audiocpp.ts",
    "smoke:player": "tsx scripts/smoke-player.ts",
    "smoke:chain": "tsx scripts/smoke-chain.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
